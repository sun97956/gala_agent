# copy to .env and fill in
DEEPSEEK_API_KEY=sk-...
# optional
TEXT_MODEL=deepseek-flash
VISION_MODEL=deepseek-flash
MAX_STEPS=15
WHISPER_MODEL=small
# HF_TOKEN=hf_...            # only for downloading attachments / local scoring from gaia-benchmark/GAIA
# STOCKFISH_PATH=C:\tools\stockfish\stockfish.exe
# HTTPS_PROXY=http://127.0.0.1:7890   # if YouTube is blocked on your network
# YTDLP_COOKIES_FROM_BROWSER=chrome     # if yt-dlp says "Sign in to confirm you are not a bot"
